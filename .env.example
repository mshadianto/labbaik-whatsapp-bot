# LABBAIK.AI WhatsApp Bot - Environment Variables
# Copy this file to .env and fill in your values

# ============ WAHA Configuration ============
# Your WAHA instance URL (without trailing slash)
WAHA_API_URL=https://waha-qikiufjwa2nh.cgk-max.sumopod.my.id

# WAHA session name (as shown in WAHA dashboard)
WAHA_SESSION=Labbaik

# WAHA API key (if configured)
WAHA_API_KEY=

# ============ Groq AI Configuration ============
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Model to use (recommended: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Maximum tokens for AI response
GROQ_MAX_TOKENS=2048

# Temperature for AI response (0.0 - 1.0)
GROQ_TEMPERATURE=0.7

# ============ Database Configuration ============
# PostgreSQL connection URL (Neon, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ============ Application Settings ============
# Set to true for development
DEBUG=false

# Server port
PORT=8000
